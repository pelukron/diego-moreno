{
  "publicFiles": ["index.html", "i18n.js", "README.md", "404.html", "styles.css"],
  "_comment_deployOnly": "live-site paths the lint set does not scan",
  "deployOnly": [".nojekyll"],
  "_comment_lintOnly": "lint-set paths that are not deployed",
  "lintOnly": ["README.md"],
  "requiredFiles": [
    "CONTEXT.md",
    "index.html",
    "i18n.js",
    "scripts/gate.mjs",
    "scripts/check-i18n.mjs",
    "scripts/check-domain.mjs",
    "scripts/decide-release.mjs",
    "scripts/domain-rules.json",
    "scripts/pages-files.txt",
    "scripts/stage-pages.sh"
  ],
  "forbidden": [
    {
      "id": "acc",
      "pattern": "\\bACC\\b",
      "message": "forbidden employer abbreviation ACC"
    },
    {
      "id": "interview-lead",
      "pattern": "Interview\\s*/\\s*Lead",
      "flags": "i",
      "message": "Interview/Lead is not a product on this URL"
    },
    {
      "id": "expired-l3-noun",
      "pattern": "Angular Expert( L3| \\(Level 3\\))",
      "message": "expired L3 is historical only; use Senior Frontend · Angular as the public noun"
    }
  ],
  "indexHtml": {
    "sectionOrder": ["cv", "mentoria"],
    "lang": "en"
  },
  "_comment_requiredFacts": "Presence and placement only. LinkedIn may stay anywhere; the L3 id, expired label, and verify URL stay under Historical credentials. C1, credential validity, and portrait stay Claims.",
  "requiredFacts": [
    {
      "id": "linkedin",
      "text": "https://www.linkedin.com/in/diego-moreno-arellano-2a36528a/",
      "placements": [
        { "artifact": "index.html", "region": "any" },
        { "artifact": "README.md", "region": "any" }
      ]
    },
    {
      "id": "l3-id",
      "text": "4J095ZM",
      "placements": [
        { "artifact": "index.html", "region": "historical" },
        { "artifact": "README.md", "region": "historical" }
      ]
    },
    {
      "id": "l3-expired",
      "text": "Expired 10 Oct 2026",
      "placements": [
        { "artifact": "index.html", "region": "historical" },
        { "artifact": "README.md", "region": "historical" }
      ]
    },
    {
      "id": "l3-verify",
      "text": "https://www.angulartraining.com/certification/check.html",
      "placements": [
        { "artifact": "index.html", "region": "historical" },
        { "artifact": "README.md", "region": "historical" }
      ]
    }
  ],
  "regions": {
    "index.html": {
      "historical": {
        "start": "data-i18n=\"cv.certHistory\"",
        "end": "data-i18n=\"cv.edu\""
      }
    },
    "README.md": {
      "historical": {
        "start": "### Historical credentials",
        "end": "\n---"
      }
    }
  },
  "_comment_cvBodyPrefixes": "family match only: exact, or trailing-dot prefix, or digit next (g1 not goals)",
  "cvBodyPrefixes": ["acc", "cv.intro", "cv.omit", "cv.p", "g", "ind."]
}
